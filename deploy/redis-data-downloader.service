[Unit]
Description=redis-data-downloader (FastAPI + React)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REMOTE_DIR__/backend
EnvironmentFile=__REMOTE_DIR__/.env
Environment=OUTPUT_DIR=__REMOTE_DIR__/output
ExecStart=__REMOTE_DIR__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port __PORT__
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
