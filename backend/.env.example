# App auth (shared password; username is free-text for run logs)
APP_PASSWORD=change-me
APP_JWT_SECRET=change-me-to-a-long-random-string

# Optional
# CORS_ORIGINS=*
# REDIS_BATCH_SIZE=50
# OUTPUT_DIR=

# Postgres (same vars as heyev-backend / getFleetSum)
DB_POSTGRES_URL=127.0.0.1
DB_POSTGRES_PORT=5432
DB_POSTGRES_DBNAME=your_db_name
DB_POSTGRES_USERNAME=postgres
DB_POSTGRES_PASS=your_password

# Redis (host:port, same as heyev-backend FetchBulkByIMEI)
REDIS_URL=127.0.0.1:6379
REDIS_PASS=
